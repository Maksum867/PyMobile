#:schema pymobile.schema.json
# PyMobile project configuration.
# Full reference: https://github.com/Maksum867/PyMobile

[app]
name = "{{name}}"
package = "{{package}}"
version = "0.1.0"
version_code = 1

# Entry point, relative to source_dir.
entrypoint = "main.py"
source_dir = "."

# Optional pure-Python PyPI packages (native extensions are not supported).
# dependencies = ["requests==2.32.5"]

# Android platform settings.
min_sdk = 24
target_sdk = 35
orientation = "portrait"

permissions = [
    "android.permission.INTERNET",
    "android.permission.VIBRATE",
    "android.permission.POST_NOTIFICATIONS",
]

# Path to a square PNG (512x512 recommended).
# Leave it out to use the default Android icon.
# icon = "assets/icon.png"

# Build settings.
abis = ["arm64-v8a"]
# Where the APK lands. "apk" rather than "build": build/ is in nearly every
# .gitignore and CI artefact rule, where a finished APK looks like it vanished.
output_dir = "apk"
optimize = false      # true ships bytecode; needs a Python 3.14 host (the device's version)
strip_debug = true    # strip docstrings and asserts (-OO)

exclude = [
    "**/__pycache__/**",
    "**/*.pyc",
    "*.md",
    "tests/**",
    "docs/**",
    ".git/**",
    ".venv/**",
    "build/**",
    "apk/**",
]
